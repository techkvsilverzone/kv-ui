# Copy to `.env` and fill in. All VITE_* vars are exposed to the browser bundle
# (no server secrets here — only publishable/client-side values).

# Backend API base URL (falls back to http://localhost:5000/api/v1 when absent)
# For the mobile (Capacitor) build this MUST point to a server the device can
# reach — a bundled app cannot see your machine's localhost. The Android
# emulator reaches the host as http://10.0.2.2:<port>; a physical device needs
# the host's LAN IP or a deployed/tunneled URL.
VITE_API_URL=http://localhost:5000/api/v1

# Build target. Leave unset for the web build. The `build:mobile` npm script
# sets VITE_APP_TARGET=mobile, which drops the /admin panel from the bundle and
# switches auth to a Bearer token (the web build stays cookie-based).
# VITE_APP_TARGET=

# Razorpay publishable key id (client-side; safe to expose)
VITE_RAZORPAY_KEY_ID=

# --- Optional: analytics & error monitoring (no-op when left blank) ---

# Sentry DSN for error monitoring
VITE_SENTRY_DSN=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
