                        <Button onClick={handleCreateProduct} disabled={createProductMutation.isPending || !productForm.name || !productForm.price || createChargesInvalid}>
                          {createProductMutation.isPending ? 'Creating...' : 'Create Product'}
                        </Button>
                      </div>
                    </DialogContent>
                  </Dialog>
