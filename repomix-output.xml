                        <div>
                          <Label htmlFor="prod-weight">Weight (e.g. 45g)</Label>
                          <Input id="prod-weight" value={productForm.weight} onChange={(e) => setProductForm({ ...productForm, weight: e.target.value })} className="mt-1" />
                        </div>
                        <VariantsEditor
