    const subtotal = order.items.reduce((sum, item) => sum + item.price * item.quantity, 0);
    const tax = order.tax ?? subtotal * 0.03;
    const orderId = (order.id ?? order._id ?? '').slice(-10).toUpperCase();

    return (
